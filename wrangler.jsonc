{
  "name": "saynue",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  // Always prepare the public asset folder, even when the dashboard
  // build command is left empty (the folder is gitignored).
  "build": {
    "command": "node scripts/build-cloudflare.mjs"
  },
  "assets": {
    "directory": "./.cloudflare-public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/",
      "/api",
      "/api/*"
    ]
  }
}
