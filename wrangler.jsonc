{
  "name": "saynue",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "./.cloudflare-public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/",
      "/api",
      "/api/*"
    ]
  }
}
