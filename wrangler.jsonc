{
  "name": "saynue",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  // Always prepare the public asset folder, even when the dashboard
  // build command is left empty (the folder is gitignored).
  "build": {
    "command": "node scripts/build-cloudflare.mjs"
  },
  // Per-IP burst limits enforced by Cloudflare before any Gemini call
  // (counted per Cloudflare location; the per-day limits stay in the API).
  "ratelimits": [
    { "name": "AI_BURST_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    { "name": "API_BURST_LIMITER", "namespace_id": "1002", "simple": { "limit": 40, "period": 60 } }
  ],
  // Workers Logs: request outcomes and the API's content-free warnings,
  // searchable in the dashboard. No chat text is ever logged.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "assets": {
    "directory": "./.cloudflare-public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/",
      "/api",
      "/api/*"
    ]
  }
}
